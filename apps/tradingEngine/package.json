{
  "name": "tradingengine",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "check-types": "tsc --noEmit",
    "start": "bun dist/index.js",
    "dev": "bun run src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vxness/db": "workspace:*",
    "@vxness/redis": "workspace:*",
    "@vxness/types": "workspace:*"
  }
}
